CREATE TABLE IF NOT EXISTS artist (
    id INTEGER PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    name_normalized TEXT
);

CREATE TABLE IF NOT EXISTS journal (
    id INTEGER PRIMARY KEY NOT NULL,
    name TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS chart (
    id INTEGER PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    journal_id INTEGER NOT NULL,
    list_size INTEGER,
    start_date TEXT,
    end_date TEXT,
    cached_at INTEGER NOT NULL,
    FOREIGN KEY (journal_id) REFERENCES journal(id)
);

CREATE TABLE IF NOT EXISTS week (
    id INTEGER PRIMARY KEY NOT NULL,
    date TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS chart_list (
    id INTEGER PRIMARY KEY NOT NULL,
    chart_id INTEGER NOT NULL,
    week_id INTEGER NOT NULL,
    cached_at INTEGER NOT NULL,
    FOREIGN KEY (chart_id) REFERENCES chart(id),
    FOREIGN KEY (week_id) REFERENCES week(id),
    UNIQUE(chart_id, week_id)
);

CREATE TABLE IF NOT EXISTS track (
    id INTEGER PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    artist_id INTEGER,
    artist_name TEXT,
    first_chart_date TEXT,
    peak_global_rank INTEGER,
    total_weeks_on_chart INTEGER DEFAULT 0,
    artwork_url TEXT,
    FOREIGN KEY (artist_id) REFERENCES artist(id)
);

CREATE TABLE IF NOT EXISTS chart_track (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    chart_list_id INTEGER NOT NULL,
    track_id INTEGER NOT NULL,
    rank INTEGER NOT NULL,
    last_week_rank INTEGER DEFAULT 0,
    FOREIGN KEY (chart_list_id) REFERENCES chart_list(id),
    FOREIGN KEY (track_id) REFERENCES track(id),
    UNIQUE(chart_list_id, track_id)
);

CREATE INDEX IF NOT EXISTS idx_chart_list_chart_id ON chart_list(chart_id);
CREATE INDEX IF NOT EXISTS idx_chart_track_list_id ON chart_track(chart_list_id);
CREATE INDEX IF NOT EXISTS idx_track_artist_id ON track(artist_id);

-- Artist Queries
selectAllArtists:
SELECT * FROM artist;

selectArtistById:
SELECT * FROM artist WHERE id = ?;

insertArtist:
INSERT OR REPLACE INTO artist (id, name, name_normalized)
VALUES (?, ?, ?);

-- Journal Queries
selectAllJournals:
SELECT * FROM journal;

selectJournalById:
SELECT * FROM journal WHERE id = ?;

insertJournal:
INSERT OR REPLACE INTO journal (id, name)
VALUES (?, ?);

-- Chart Queries
selectAllCharts:
SELECT * FROM chart;

selectChartById:
SELECT * FROM chart WHERE id = ?;

insertChart:
INSERT OR REPLACE INTO chart (id, name, journal_id, list_size, start_date, end_date, cached_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAllCharts:
DELETE FROM chart;

deleteAllJournals:
DELETE FROM journal;

deleteAllWeeks:
DELETE FROM week;

deleteAllChartLists:
DELETE FROM chart_list;

deleteAllTracks:
DELETE FROM track;

deleteAllArtists:
DELETE FROM artist;

deleteAllChartTracks:
DELETE FROM chart_track;

-- Week Queries
selectAllWeeks:
SELECT * FROM week;

selectWeekById:
SELECT * FROM week WHERE id = ?;

selectWeekByDate:
SELECT * FROM week WHERE date = ?;

insertWeek:
INSERT OR REPLACE INTO week (id, date)
VALUES (?, ?);

-- ChartList Queries
selectAllChartLists:
SELECT * FROM chart_list;

selectChartListById:
SELECT * FROM chart_list WHERE id = ?;

selectChartListByChartAndWeek:
SELECT * FROM chart_list WHERE chart_id = ? AND week_id = ?;

insertChartList:
INSERT OR REPLACE INTO chart_list (id, chart_id, week_id, cached_at)
VALUES (?, ?, ?, ?);

-- Track Queries
selectAllTracks:
SELECT * FROM track;

selectTrackById:
SELECT * FROM track WHERE id = ?;

insertTrack:
INSERT OR REPLACE INTO track (id, title, artist_id, artist_name, first_chart_date, peak_global_rank, total_weeks_on_chart, artwork_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- ChartTrack Queries
selectChartTracksByListId:
SELECT * FROM chart_track WHERE chart_list_id = ?;

selectChartTracksWithDetailsById:
SELECT
    ct.id AS chart_track_id,
    ct.rank,
    ct.last_week_rank,
    t.id AS track_id,
    t.title AS track_title,
    t.artist_name AS track_artist_name,
    t.first_chart_date,
    t.peak_global_rank,
    t.total_weeks_on_chart,
    t.artwork_url,
    a.id AS artist_id,
    a.name AS artist_name,
    a.name_normalized AS artist_name_normalized
FROM chart_track ct
JOIN track t ON ct.track_id = t.id
LEFT JOIN artist a ON t.artist_id = a.id
WHERE ct.chart_list_id = ?
ORDER BY ct.rank;

insertChartTrack:
INSERT OR REPLACE INTO chart_track (chart_list_id, track_id, rank, last_week_rank)
VALUES (?, ?, ?, ?);
