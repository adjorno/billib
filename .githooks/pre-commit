#!/bin/bash
# Git pre-commit hook to run ktlint and detekt checks
# Prevents commits with code style violations and code quality issues
#
# Installation:
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use the install script:
#   .githooks/install.sh

echo "🔍 Running pre-commit checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FAILED=0

# Run ktlint check
echo "⏳ Running ktlint..."
./gradlew ktlintCheck --quiet

if [ $? -ne 0 ]; then
    echo ""
    echo -e "${RED}❌ ktlint check failed!${NC}"
    echo ""
    echo -e "${YELLOW}💡 To fix automatically, run:${NC}"
    echo "   ./gradlew ktlintFormat"
    echo ""
    echo -e "${YELLOW}💡 Or use the skill:${NC}"
    echo "   /ktlint-fix"
    echo ""
    FAILED=1
else
    echo -e "${GREEN}✅ ktlint check passed${NC}"
fi

echo ""

# Run detekt check (frontend multiplatform modules)
echo "⏳ Running detekt..."
./gradlew detektMetadataCommonMain --quiet

if [ $? -ne 0 ]; then
    echo ""
    echo -e "${RED}❌ detekt check failed!${NC}"
    echo ""
    echo -e "${YELLOW}💡 Review the detekt report for details${NC}"
    echo ""
    FAILED=1
else
    echo -e "${GREEN}✅ detekt check passed${NC}"
fi

echo ""

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo ""
    echo -e "${YELLOW}To commit anyway (not recommended), use:${NC}"
    echo "   git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo ""

exit 0
